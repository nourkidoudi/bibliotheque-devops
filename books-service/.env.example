# Server
PORT=3002
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=books_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (must match users-service)
JWT_SECRET=your_jwt_secret_key_here

# Service-to-service authentication
SERVICE_KEY=your_internal_service_key_here

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=dev
